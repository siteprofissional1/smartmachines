# SmartMachines — Variáveis de Ambiente de Exemplo
# Preencha com suas configurações reais em .env (NUNCA envie .env para o repositório)

# Firebase Web SDK (Configuração Pública do Cliente Frontend)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Gemini API (Exclusivo para Pipeline Seguro em Python / Backend)
# NUNCA prefixe com VITE_ para não vazar no bundle do cliente!
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK (Opcional para escrita direta via Python Admin)
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/service-account.json

# Modo de Demonstração / Fallback
VITE_APP_MODE=AUTO
