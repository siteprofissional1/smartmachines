rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leitura pública dos dados de monitoramento e telemetria para o Dashboard demonstrativo
    match /machines/{machineId} {
      allow read: if true;
      allow write: if false; // Escrita permitida apenas pelo pipeline seguro (Admin SDK / Backend)
    }

    match /parts_quotes/{partCode} {
      allow read: if true;
      allow write: if false;
    }

    match /ai_insights/{machineId} {
      allow read: if true;
      allow write: if false;
    }

    match /plant_insights/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /system_status/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    // Regra fallback segura para qualquer outro documento
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
